// Passenger functionality
Function PassengerRegister(username, password, details):
    If valid(details):
        Store details in the system
        Display "Registration Confirmation"
    Else:
        Display "Error: Invalid Details"

Function PassengerLogin(username, password):
    If credentials match:
        Display "Login Success"
    Else:
        Display "Error: Incorrect Username or Password"

Function BookTaxi(passengerId, location, destination):
    Display available drivers
    selectedDriver = SelectDriver()
    NotifyDriver(selectedDriver, "New Booking")
    If driver accepts:
        ConfirmBooking(passengerId, selectedDriver, location, destination)
    Else:
        Display "Error: Booking Rejected"

Function MakePayment(bookingId, paymentDetails):
    If valid(paymentDetails):
        Process payment
        Display "Payment Confirmation"
    Else:
        Display "Error: Payment Failed"

Function PassengerLogout(passengerId):
    Log passenger out
    Display "Logout Confirmation"


