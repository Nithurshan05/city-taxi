Function ChangeTaxiStatus(driverId, newStatus):
    Update driver's taxi status (e.g., Available/Unavailable)
    Display "Status Updated"

Function TrackPassengerLocation(bookingId):
    Get passenger location from system
    Display passenger location to driver

Function DriverLogout(driverId):
    Log driver out
    Display "Logout Confirmation"


// Telephone Operator functionality
Function OperatorBookTaxiForPassenger(passengerDetails, location, destination):
    If valid(passengerDetails):
        selectedDriver = SelectDriver()
        NotifyDriver(selectedDriver, "New Booking")
        If driver accepts:
            ConfirmBooking(passengerDetails, selectedDriver, location, destination)
            Display "Booking Confirmation"
        Else:
            Display "Error: Booking Rejected"
    Else:
        Display "Error: Invalid Passenger Details"


